# Copiar para configuracao/sensivel/.env.
# GitHub Actions: um Secret por variável, só o valor (sem aspas e sem o comentário).

# BOTS DO TELEGRAM
# Token: gerado pelo @BotFather. Chat id: id da conversa com o bot.
TELEGRAM_ESTAGIO_BOT_TOKEN=123456789:token-do-bot-de-estagio
TELEGRAM_ESTAGIO_CHAT_ID=123456789
TELEGRAM_PRIORIDADE_BOT_TOKEN=123456789:token-do-bot-de-prioridade  # opcional > sem ele, vai para o bot de estágio
TELEGRAM_PRIORIDADE_CHAT_ID=123456789
TELEGRAM_TI_BOT_TOKEN=123456789:token-do-bot-de-ti                  # opcional > sem ele, vai para o bot de estágio
TELEGRAM_TI_CHAT_ID=123456789

# LOCAL
CIDADE_BASE=Campinas  # única cidade aceita para vaga híbrida
UF_BASE=SP            # estado aceito quando vaga remota exige residência

# ÁREA DESEJADA (listas: vírgula, entre aspas)
AREA_TERMOS="designer,ux,ui,figma,prototipação"  # termos específicos > 1 no título ou 2 na descrição
AREA_TERMOS_TITULO="design,produto"              # termos amplos > só no título

# ÁREA INDESEJADA
AREA_EXCLUIR="vendas,telemarketing"  # descarta pelo título ou descrição
AREA_EXCLUIR_TITULO="sênior,pleno"   # descarta só pelo título

# ESTRELAS (+1 por lista com termo no título)
ESTRELAS_TERMOS_AREA="designer,ux"       # área desejada
ESTRELAS_TERMOS_PERFIL="figma,pesquisa"  # habilidades

# EMPRESAS
EMPRESAS_PRIORITARIAS="Empresa Exemplo"  # sempre exibidas, em bot próprio
EMPRESAS_BLOQUEADAS="Empresa Bloqueada"  # nunca exibidas

# SITE DA EMPRESA PRIORITÁRIA (opcional > vazio desliga a fonte)
PRIORIDADE_NOME_EMPRESA=Empresa Exemplo             # nome exibido nas vagas
PRIORIDADE_FIRESTORE_PROJETO=projeto-exemplo        # do código público do site de carreiras
PRIORIDADE_FIRESTORE_CHAVE=chave-publica-exemplo    # do código público do site de carreiras
PRIORIDADE_URL_VAGAS=https://exemplo.com/carreiras  # link quando a vaga não traz o próprio
